{
  "name": "nestjs-step-by-step-course",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS 逐课代码演进课程",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "lesson": "node scripts/run-lesson.mjs",
    "lesson:diff": "node scripts/diff-lesson.mjs",
    "lesson:diff:all": "node scripts/diff-all-lesson.mjs",
    "lesson:test": "node scripts/test-lesson.mjs",
    "check": "npm run check:structure && tsc --noEmit",
    "check:structure": "node scripts/check-lessons.mjs",
    "format": "prettier --write \"**/*.{ts,md,json,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json,mjs}\""
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "3.0.2",
    "better-sqlite3": "12.11.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "joi": "18.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.12",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.2"
    }
  }
}
